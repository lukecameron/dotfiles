# Homebrew owns operating-system packages. This file is additive: setup never
# removes packages that are not listed here.

tap "ariga/tap"
tap "rjyo/moshi", trusted: true
tap "withgraphite/tap"

# Shell and dotfile management
brew "bash"
brew "chezmoi"
brew "fzf"
brew "mise"
brew "starship"
brew "zsh-autosuggestions"

# Development essentials
brew "ariga/tap/atlas"
brew "btop"
brew "fd"
brew "gh"
brew "git"
brew "git-lfs"
brew "withgraphite/tap/graphite"
brew "jq"
brew "lazygit"
brew "neovim"
brew "newman"
brew "pnpm"
brew "poppler"
brew "ripgrep"
brew "tree-sitter-cli"
brew "usage"
brew "uv"

# Coding harnesses and terminal workflow
brew "mosh"
brew "rjyo/moshi/moshi-hook", restart_service: true
brew "opencode"
brew "herdr"
brew "bun"
cask "1password-cli"
cask "claude-code"
cask "codex"
cask "font-jetbrains-mono"
cask "gcloud-cli"
cask "ghostty"
cask "opensuperwhisper"

{{- if eq .role "work" }}

# Work-only packages belong here.
{{- else if eq .role "personal" }}

# Personal-only packages belong here.
{{- end }}
