#!/bin/sh
set -eu

input=$(cat)
if [ -z "$input" ]; then
	input='{}'
fi

printf '%s\n' "$input" | jq '
  .theme = "light"
  | .defaultProvider = "openai-codex"
  | .defaultModel = "gpt-5.5"
  | .defaultThinkingLevel = "medium"
  | .hideThinkingBlock = true
  | .quietStartup = true
  | .collapseChangelog = true
  | .steeringMode = "all"
  | .followUpMode = "all"
  | .npmCommand = ["mise", "exec", "--", "npm"]
  | .packages = (
      (.packages // [])
      | map(select(
          . != "npm:pi-autoresearch"
          and (if type == "string" then (test("^npm:pi-web-access(?:@|$)") | not) else true end)
        ))
      + ["npm:pi-web-access@0.14.0"]
    )
'
