#!/bin/sh
set -eu

input=$(cat)
if [ -z "$input" ]; then
	input='{}'
fi

printf '%s\n' "$input" | jq '
  .theme = "light"
  | .defaultProvider = "openai-codex"
  | .defaultModel = "gpt-5.5"
  | .defaultThinkingLevel = "medium"
  | .packages = ((.packages // []) | map(select(. != "npm:pi-autoresearch")))
'
