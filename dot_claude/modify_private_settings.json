#!/bin/sh
set -eu

input=$(cat)
if [ -z "$input" ]; then
	input='{}'
fi

# Keys this repo owns in ~/.claude/settings.json. Everything else in the file
# is left to Claude Code and the tools that write it.
printf '%s\n' "$input" | jq '
	.skipDangerousModePermissionPrompt = true
	| .statusLine = {
		type: "command",
		command: "~/.claude/statusline.sh",
		refreshInterval: 60
	}
	| .hooks.SessionEnd = (
		[(.hooks.SessionEnd // [])[]
			| select(any(.hooks[]?; .command == "~/.claude/hooks/stop-chrome-devtools-axi.sh") | not)]
		+ [{
			matcher: "",
			hooks: [{
				type: "command",
				command: "~/.claude/hooks/stop-chrome-devtools-axi.sh",
				timeout: 10
			}]
		}]
	)
'
