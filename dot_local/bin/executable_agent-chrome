#!/bin/sh
# Start the shared agent browser on demand and wait until it accepts connections.
# macOS owns the process, so it survives the invoking shell and can be quit normally.
set -eu

data_dir="$HOME/Library/Application Support/agent-chrome"
canary="/Applications/Google Chrome Canary.app"

ready() {
	curl --fail --silent --output /dev/null --connect-timeout 1 --max-time 1 \
		http://127.0.0.1:9223/json/version
}

ready && exit 0

# The mock keychain keeps this browser away from the login keychain, as
# chrome-devtools-axi does for the browsers it launches.
open -n -a "$canary" --args \
	--user-data-dir="$data_dir" \
	--remote-debugging-port=9223 \
	--no-first-run \
	--no-default-browser-check \
	--use-mock-keychain \
	--password-store=basic

attempt=0
while [ "$attempt" -lt 50 ]; do
	ready && exit 0
	attempt=$((attempt + 1))
	sleep 0.2
done

echo "Agent Chrome did not become ready on 127.0.0.1:9223." >&2
exit 1
