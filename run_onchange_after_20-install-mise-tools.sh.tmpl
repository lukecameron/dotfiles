#!/bin/sh
set -eu

# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

if [ -x /opt/homebrew/bin/mise ]; then
	mise=/opt/homebrew/bin/mise
elif [ -x /usr/local/bin/mise ]; then
	mise=/usr/local/bin/mise
else
	echo "mise was not installed by Homebrew." >&2
	exit 1
fi

"$mise" trust --quiet "$HOME/.config/mise/config.toml"
"$mise" install
# `mise install` leaves an installed tool alone, so tools tracking a channel
# such as "latest" or "lts" only move when they are upgraded.
"$mise" upgrade
