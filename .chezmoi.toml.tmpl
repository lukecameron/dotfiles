{{- $roles := list "personal" "work" -}}
{{- $role := promptChoiceOnce . "role" "Machine role" $roles "personal" -}}
{{- $machineNames := list "m1-air" "mitti-air" "slate-pro" -}}
{{- $defaultMachineName := "m1-air" -}}
{{- if eq $role "work" -}}
{{- $defaultMachineName = "mitti-air" -}}
{{- end -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $machineNames = append $machineNames "marcus" -}}
{{- $defaultMachineName = "marcus" -}}
{{- end -}}
{{- $machineName := promptChoiceOnce . "machineName" "Machine prompt name" $machineNames $defaultMachineName -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    role = {{ $role | quote }}
    machineName = {{ $machineName | quote }}
