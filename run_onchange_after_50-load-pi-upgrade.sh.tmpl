#!/bin/sh
set -eu

# Reload the agent whenever its plist changes.
# plist: {{ include "private_Library/LaunchAgents/com.lukecameron.pi-upgrade.plist.tmpl" | sha256sum }}

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

label=com.lukecameron.pi-upgrade
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"

launchctl bootout "$domain/$label" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist"
