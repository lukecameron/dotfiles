{{- $defaultMachineName := "m1-air" -}}
{{- if eq .role "work" -}}
{{- $defaultMachineName = "mitti-air" -}}
{{- end -}}
{{- $machineName := get . "machineName" | default $defaultMachineName -}}
# Minimal, colourful prompt.

format = """
[{{ $machineName }}](bold #9B59B6) \
$directory\
$git_branch\
$git_status\
$fill\
$cmd_duration\
$line_break\
$character\
"""

[directory]
style = "#00FF87"
truncation_length = 3
truncate_to_repo = true
read_only = " 🔒"
home_symbol = "~"

[git_branch]
format = " on [$symbol$branch]($style) "
style = "#FF6BC1"

[git_status]
style = "#FF6BC1"
format = '([\[$all_status$ahead_behind\]]($style)) '
conflicted = "🏳"
ahead = "⇡$count"
behind = "⇣$count"
diverged = "⇕$ahead_count⇣$behind_count"
staged = "+${count}"
modified = "!${count}"
stashed = "📦"
deleted = "✘${count}"
renamed = "→${count}"
untracked = "?${count}"

[fill]
symbol = " "

[cmd_duration]
min_time = 2000
format = "took [$duration](bold #FFD866) "

[character]
success_symbol = "[❯](bold #9B59B6)"
error_symbol = "[❯](bold #FF6188)"
vicmd_symbol = "[❮](bold #78DCE8)"
