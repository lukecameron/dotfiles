# Keep executable discovery consistent for interactive shells and remote
# commands such as the mosh-server process started over SSH.
typeset -U path PATH

path=($HOME/.local/bin $path)

if [[ -d /opt/homebrew/bin ]]; then
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
elif [[ -d /usr/local/Homebrew/bin ]]; then
  path=(/usr/local/bin /usr/local/sbin $path)
fi

export NO_MISTAKES_TELEMETRY=0

# Claude Code loads mods (function-hook plugins such as claude-mods/pacman)
# only with this early-access flag.
export CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1

# Agent browsers launched by chrome-devtools-axi run in Chrome Canary. A
# headless /Applications/Google Chrome.app left behind by an agent takes over
# the Chrome Dock icon, which then activates a process with no windows.
if [[ $OSTYPE == darwin* ]]; then
  export CHROME_DEVTOOLS_AXI_CHANNEL=canary
fi
