#!/bin/sh
set -eu

# Smart Rename plugin: iurysza/herdr-tab-smart-rename@a580a9ef248357ea9d85cf0f2131acb2e3fae240

plugin_ref=a580a9ef248357ea9d85cf0f2131acb2e3fae240
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
plugins_json="$config_home/herdr/plugins.json"

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

# Avoid contacting a running Herdr server when the requested immutable revision
# is already installed. This also makes upgrades from older server protocols safe.
if [ -r "$plugins_json" ] && jq -e --arg ref "$plugin_ref" \
	'any(.[]?; .source.owner == "iurysza" and .source.repo == "herdr-tab-smart-rename" and .source.resolved_commit == $ref)' \
	"$plugins_json" >/dev/null 2>&1; then
	exit 0
fi

if [ -x /opt/homebrew/bin/herdr ]; then
	herdr=/opt/homebrew/bin/herdr
elif [ -x /usr/local/bin/herdr ]; then
	herdr=/usr/local/bin/herdr
else
	echo "herdr was not installed by Homebrew." >&2
	exit 1
fi

if [ -x /opt/homebrew/bin/mise ]; then
	mise=/opt/homebrew/bin/mise
elif [ -x /usr/local/bin/mise ]; then
	mise=/usr/local/bin/mise
else
	echo "mise was not installed by Homebrew." >&2
	exit 1
fi

"$mise" exec -- "$herdr" plugin install \
	iurysza/herdr-tab-smart-rename \
	--ref "$plugin_ref" \
	--yes
