#!/bin/sh
set -eu

# Herdr plugins, pinned to immutable revisions. Herdr builds both from source
# with Go, which mise installs.
#   Auto Title: kryptamine/herdr-auto-title@0cf776db9a9450f1b190b4f3d787674c7a9d3ddb (v0.13.0)
#   Spaces:     lukecameron/herdr-spaces@c81565ae75c948852272ecdb5204ee888115e0f2 (v0.2.0)

auto_title_ref=0cf776db9a9450f1b190b4f3d787674c7a9d3ddb
spaces_ref=c81565ae75c948852272ecdb5204ee888115e0f2
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
plugins_json="$config_home/herdr/plugins.json"

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

if [ -x /opt/homebrew/bin/herdr ]; then
	herdr=/opt/homebrew/bin/herdr
elif [ -x /usr/local/bin/herdr ]; then
	herdr=/usr/local/bin/herdr
else
	echo "herdr was not installed by Homebrew." >&2
	exit 1
fi

if [ -x /opt/homebrew/bin/mise ]; then
	mise=/opt/homebrew/bin/mise
elif [ -x /usr/local/bin/mise ]; then
	mise=/usr/local/bin/mise
else
	echo "mise was not installed by Homebrew." >&2
	exit 1
fi

# Herdr's Claude Code hook tells Herdr which session each pane holds, so Auto
# Title can name a tab even before Claude has set a terminal title. Idempotent.
"$herdr" integration install claude

# Smart Rename was replaced by Auto Title; remove it where it is still installed.
if [ -r "$plugins_json" ] && jq -e 'any(.[]?; .plugin_id == "tab-smart-rename")' "$plugins_json" >/dev/null 2>&1; then
	yes | "$herdr" plugin uninstall tab-smart-rename
fi

# install_plugin OWNER REPO REF: install a GitHub plugin unless that exact
# revision is already registered, which avoids contacting a running server.
install_plugin() {
	owner=$1
	repo=$2
	ref=$3
	if [ -r "$plugins_json" ] && jq -e --arg owner "$owner" --arg repo "$repo" --arg ref "$ref" \
		'any(.[]?; .source.owner == $owner and .source.repo == $repo and .source.resolved_commit == $ref)' \
		"$plugins_json" >/dev/null 2>&1; then
		return 0
	fi
	"$mise" exec -- "$herdr" plugin install "$owner/$repo" --ref "$ref" --yes
	echo "$repo starts with the Herdr server; run 'herdr server stop' and reopen herdr when convenient." >&2
}

install_plugin kryptamine herdr-auto-title "$auto_title_ref"
install_plugin lukecameron herdr-spaces "$spaces_ref"

# The Spaces plugin counts Claude Code subagents through a hook it installs
# into ~/.claude. Idempotent; the binary is wherever Herdr checked the plugin out.
for spaces_bin in "$config_home"/herdr/plugins/github/lukecameron.spaces-*/herdr-spaces; do
	if [ -x "$spaces_bin" ]; then
		HERDR_PLUGIN_ROOT=$(dirname "$spaces_bin") "$spaces_bin" install-claude-hook
		break
	fi
done
