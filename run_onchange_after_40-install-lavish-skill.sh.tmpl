#!/bin/sh
set -eu

# The /lavish skill (kunchenguid/lavish-axi) for Claude Code, Codex, Pi and
# OpenCode at user level. The skills CLI puts it in ~/.agents/skills, which
# Codex, Pi and OpenCode read, and links it into ~/.claude/skills. The skill
# drives the lavish-axi CLI, which mise installs from dot_config/mise.
#
# Only `lavish` is named: the repository's other SKILL.md, lavish-design, is
# for agents working on lavish itself.
#
# Bump this marker to reinstall from the repository's main branch.
# Read the new SKILL.md first: it is instructions agents will follow.
# lavish refresh: b184b58

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

if [ -x /opt/homebrew/bin/mise ]; then
	mise=/opt/homebrew/bin/mise
else
	mise=/usr/local/bin/mise
fi

export DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
"$mise" exec node@lts -- npx -y skills@latest add kunchenguid/lavish-axi \
	--global --agent claude-code --agent codex --agent pi --agent opencode \
	--skill lavish --yes
