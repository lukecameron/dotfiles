#!/bin/sh
set -eu

# Claude Code plugins from the official marketplace. Installing one that is
# already installed changes nothing, so this only fills in missing plugins.
# The Datadog site the dotfiles keep in the plugin's data directory is applied
# to a fresh install, as the plugin's own /datadog:ddsetup would apply it.

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
	exit 0
fi

PATH="$HOME/.local/bin:$PATH"
export PATH

{{- if eq .role "work" }}

claude plugin install datadog@claude-plugins-official

# datadog-domain: {{ include "dot_claude/plugins/data/datadog-claude-plugins-official/domain" | sha256sum }}
domain=$(cat "$HOME/.claude/plugins/data/datadog-claude-plugins-official/domain")
registration=$(jq -r '.plugins["datadog@claude-plugins-official"][0].installPath' \
	"$HOME/.claude/plugins/installed_plugins.json")/.dd_claude-code_mcp.json
sed -i '' "s/\${DD_MCP_DOMAIN:-[^}]*}/\${DD_MCP_DOMAIN:-$domain}/" "$registration"
{{- end }}
